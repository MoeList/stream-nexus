<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.simonking.stream</groupId>
        <artifactId>stream-nexus</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <groupId>com.simonking.stream</groupId>
    <artifactId>nexus-sse</artifactId>
    <version>2.0.0</version>
    <name>nexus-sse</name>
    <description>nexus-sse</description>

    <dependencies>
        <dependency>
            <groupId>com.simonking.stream</groupId>
            <artifactId>nexus-common</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- 集群模式的跨节点总线。单机模式（nexus.sse.cluster.enabled=false）
             不会创建任何 Redis 连接，也不要求本机有 Redis；依赖存在只是让
             RedisSseBroadcaster 能编译并按条件装配 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- 集群模式的管理页登录态共享（Spring Session Redis）。
             依赖存在不等于启用：启动类排除 SessionDataRedisAutoConfiguration，
             且只有 SseSessionConfig（cluster.enabled=true）才声明 RedisSessionRepository；
             单机继续用容器内存 session，不需要 Redis -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-session-data-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.lionsoul</groupId>
            <artifactId>ip2region</artifactId>
        </dependency>
    </dependencies>
</project>
